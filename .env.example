# Same-origin gateway
PORT=3002
APP_ORIGIN=http://localhost:3002
SESSION_TTL_MS=28800000
# Explicit proxy trust: false, a positive hop count, or an allowlist.
TRUST_PROXY=false
# Required in production. Use a TLS Redis URL where supported by the provider.
REDIS_URL=

# Required together for Stellar Lab/production capability issuance. This is a
# protected, installed authority artifact; a repository-relative fallback is refused.
STELLAR_LAB_MODE=false
STELLAR_CONTRACT_CNG_KEY_REFERENCE=
STELLAR_MACHINE_ID=
STELLAR_INSTALL_ID=
STELLAR_CUSTODIAN_POLICY_AUTHORITY_PATH=
# Protected installed artifacts. Repository-relative paths are refused.
STELLAR_CUSTODIAN_POLICY_ENVELOPE_PATH=
STELLAR_REQUEST_SIGNER_REGISTRY_PATH=
# The bridge is an installed, separately authenticated Windows service. Node
# never connects directly to the Custodian or accesses its private key.
STELLAR_LAB_GATEWAY_BRIDGE_ACCOUNT=
STELLAR_LAB_GATEWAY_BRIDGE_SERVICE_NAME=
STELLAR_LAB_GATEWAY_BRIDGE_PATH=
STELLAR_LAB_GATEWAY_BRIDGE_PIPE=

# Microsoft Entra single-tenant application
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_REDIRECT_URI=http://localhost:3002/auth/entra/callback

# Local development only. Never commit a value.
ENTRA_CLIENT_SECRET=

# Production requires the certificate credential instead of a client secret.
ENTRA_CLIENT_CERT_THUMBPRINT=
# Encode line breaks as literal \\n sequences when supplied through an environment variable.
ENTRA_CLIENT_CERT_PRIVATE_KEY=
