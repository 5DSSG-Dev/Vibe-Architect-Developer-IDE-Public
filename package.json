{
  "name": "vibe-architect-developer-ide",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:client": "vite --force",
    "build": "tsc && tsc -p tsconfig.server.json && tsc -p tsconfig.server.build.json && vite build",
    "start": "node dist-server/server/index.js",
    "test": "npm run test:gateway && npm run test:app",
    "test:gateway": "tsx --test \"server/**/*.test.ts\"",
    "test:app": "tsx --test src/**/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/msal-node": "^5.5.0",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^6.2.0",
    "tailwind-merge": "^2.5.2",
    "three": "^0.168.0",
    "three-stdlib": "^2.30.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.168.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.11",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
